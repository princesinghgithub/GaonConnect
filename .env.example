# Backend API base URL. Vite bakes this into the build at build time —
# changing it requires a rebuild, not just a restart.
VITE_API_URL=http://localhost:5000/api

# EmailJS (contact form on the landing page) — from emailjs.com dashboard.
# Email Services > your Gmail service id; Email Templates > your template id;
# Account > General > Public Key. The template's "To Email" should be set to
# gaonconnect.in@gmail.com (or read {{to_email}}, sent as a hidden field).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
